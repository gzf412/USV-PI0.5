# Activate a Python 3.11 environment containing the model dependencies first.
USV_MODEL_PYTHON=python
# Gazebo bindings use the system Python, separate from the model environment.
USV_SIM_PYTHON=/usr/bin/python3
USV_ROS_SETUP=/opt/ros/jazzy/setup.bash
# The video encoder can be discovered through this Python's imageio-ffmpeg.
# USV_VIDEO_PYTHON=/your/model-environment/bin/python
# Alternatively point directly to an ffmpeg executable.
# USV_FFMPEG=/your/ffmpeg
# Optional: these default to directories inside the project.
# USV_DATA_HOME=/your/lerobot-root
# USV_CACHE_DIR=/your/model-and-hf-cache
# USV_OUTPUT_DIR=/your/run-outputs

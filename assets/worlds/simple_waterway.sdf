            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>model://mb_round_buoy_orange/meshes/mb_round_buoy.dae</uri>
                    <scale>3 3 3</scale></mesh>
                </geometry>
                <material>
                    <ambient>1 0.02 0.02 1</ambient>
                    <diffuse>1 0.02 0.02 1</diffuse>
                    <specular>0.08 0.08 0.08 1</specular>
                    <pbr>
                        <metal>
                            <roughness_map>model://mb_round_buoy_orange/materials/textures/RoundBarrierBuoy_Roughness.png</roughness_map>
                        </metal>
                    </pbr>
                </material>
